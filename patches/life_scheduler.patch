+    def _get_cycle_hint(self) -> str:
+        """读取 bio_cycle 插件的当日身体节律，用于让日程随生理周期起伏。
+
+        通过 get_all_stars 发现 bio_cycle 实例并调用其同步公共方法
+        get_cycle_context()；插件未装/未启用/未设定起点时返回空串，优雅降级。
+        """
+        try:
+            for plugin in self.context.get_all_stars():
+                p_id = str(getattr(plugin, "id", "") or "")
+                p_name = str(getattr(plugin, "name", "") or "")
+                if "bio_cycle" not in p_id and "bio_cycle" not in p_name:
+                    continue
+                inst = (
+                    getattr(plugin, "instance", None)
+                    or getattr(plugin, "star_instance", None)
+                    or getattr(plugin, "star_cls", None)
+                )
+                if inst is None or not hasattr(inst, "get_cycle_context"):
+                    return ""
+                ctx = inst.get_cycle_context()
+                if isinstance(ctx, dict) and ctx.get("enabled"):
+                    return str(ctx.get("schedule_hint", "") or "").strip()
+                return ""
+        except Exception as e:
+            logger.debug(f"[life_scheduler] 读取 bio_cycle 周期上下文失败: {e}")
+        return ""
+
