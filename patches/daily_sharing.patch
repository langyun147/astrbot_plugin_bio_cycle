+    # ---------- 生理周期 / 好感关系状态锚（主动分享专用） ----------
+
+    def _find_plugin_instance(self, keyword: str):
+        """按关键字发现插件实例，参照本仓库既定的跨插件发现模式。"""
+        try:
+            for plugin in self.context.get_all_stars():
+                p_id = str(getattr(plugin, "id", "") or "")
+                p_name = str(getattr(plugin, "name", "") or "")
+                if keyword in p_id or keyword in p_name:
+                    return (
+                        getattr(plugin, "instance", None)
+                        or getattr(plugin, "star_instance", None)
+                        or getattr(plugin, "star_cls", None)
+                    )
+        except Exception as e:
+            logger.debug(f"[内容服务] 查找插件 '{keyword}' 失败: {e}")
+        return None
+
+    @staticmethod
+    def _parse_active_identity(target_id: str) -> Tuple[bool, str]:
+        """从 UMO 解析 (是否群聊, 对方 user_id)。
+
+        私聊（FriendMessage/PrivateMessage）返回真实 user_id；群聊/广播返回 ("", is_group=True)。
+        """
+        text = str(target_id or "")
+        if not text or text == "qzone_broadcast":
+            return True, ""
+        lowered = text.lower()
+        is_group = any(k in lowered for k in ("group", "guild", "channel", "room"))
+        if is_group:
+            return True, ""
+        # 三段式 UMO: platform:msg_type:real_id
+        parts = text.split(":", 2)
+        real_id = parts[2].strip() if len(parts) == 3 else text.strip()
+        return False, real_id
+
+    def _build_favour_anchor(self, target_id: str) -> str:
+        """私聊场景下取 favorpro 只读好感关系锚；群聊/广播返回空串。"""
+        is_group, user_id = self._parse_active_identity(target_id)
+        if is_group or not user_id:
+            return ""
+        plugin = self._find_plugin_instance("favorpro")
+        if not plugin or not hasattr(plugin, "build_external_favour_anchor"):
+            return ""
+        try:
+            return str(plugin.build_external_favour_anchor(user_id) or "").strip()
+        except Exception as e:
+            logger.debug(f"[内容服务] 调用 favorpro 好感锚失败: {e}")
+            return ""
+
+    def _build_cycle_anchor(self, target_id: str) -> str:
+        """取 bio_cycle 身体状态锚；私聊够亲密时附带私密表达许可。"""
+        if target_id == "qzone_broadcast":
+            return ""
+        plugin = self._find_plugin_instance("bio_cycle")
+        if not plugin or not hasattr(plugin, "build_external_cycle_anchor"):
+            return ""
+        favour = relationship = None
+        is_group, user_id = self._parse_active_identity(target_id)
+        if not is_group and user_id:
+            fav = self._find_plugin_instance("favorpro")
+            if fav is not None:
+                try:
+                    state = fav.manager.get_user_state(
+                        fav.manager.normalize_identifier(user_id), None,
+                        fav._identity_fallback_keys(user_id),
+                    )
+                    favour = state.get("favour")
+                    relationship = state.get("relationship")
+                except Exception as e:
+                    logger.debug(f"[内容服务] 读取 favorpro 状态用于亲密度门控失败: {e}")
+        try:
+            return str(
+                plugin.build_external_cycle_anchor(
+                    target_id, purpose="active_share",
+                    favour=favour, relationship=relationship,
+                ) or ""
+            ).strip()
+        except Exception as e:
+            logger.debug(f"[内容服务] 调用 bio_cycle 周期锚失败: {e}")
+            return ""
+
+    def _build_active_state_anchors(self, target_id: str) -> str:
+        """聚合主动分享要追加的状态锚：周期 + 好感（时间/日程在别处已注入）。
+
+        受 context_conf.inject_persona_state 开关控制，默认开启。
+        """
+        if not self.context_conf.get("inject_persona_state", True):
+            return ""
+        segments = [
+            self._build_cycle_anchor(target_id),
+            self._build_favour_anchor(target_id),
+        ]
+        return "\n\n".join(s for s in segments if s)
+
